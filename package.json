{
  "name": "tro.gg",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:module": "tsc -p spacetimedb/tsconfig.json --noEmit",
    "test": "TSX_TSCONFIG_PATH=test/tsconfig.json node --import tsx --test \"shared/*.test.ts\" \"src/*.test.ts\" \"test/*.test.ts\"",
    "test:e2e": "playwright test",
    "policy:sync": "ras-stack-policy sync",
    "policy:check": "ras-stack-policy check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset tag"
  },
  "dependencies": {
    "oidc-client-ts": "^3.5.0",
    "posthog-js": "^1.391.2",
    "spacetimedb": "2.6.*",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@playwright/test": "^1.61.1",
    "@types/three": "^0.185.0",
    "ras-stack": "^0.8.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
