{
  "name": "tro.gg",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:module": "tsc -p spacetimedb/tsconfig.json --noEmit",
    "test": "TSX_TSCONFIG_PATH=test/tsconfig.json node --import tsx --test \"shared/*.test.ts\" \"src/*.test.ts\" \"test/*.test.ts\"",
    "test:e2e": "playwright test",
    "policy:sync": "ras policy sync",
    "policy:check": "ras policy check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset tag"
  },
  "dependencies": {
    "oidc-client-ts": "^3.5.0",
    "posthog-js": "^1.427.2",
    "spacetimedb": "2.10.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.185.4",
    "ras-stack": "^0.47.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
