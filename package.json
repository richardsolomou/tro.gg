{
  "name": "tro.gg",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:module": "tsc -p spacetimedb/tsconfig.json --noEmit",
    "test": "TSX_TSCONFIG_PATH=test/tsconfig.json node --import tsx --test \"shared/*.test.ts\" \"src/*.test.ts\" \"test/*.test.ts\"",
    "test:e2e": "playwright test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset tag",
    "changesets:check": "ras changesets check"
  },
  "dependencies": {
    "oidc-client-ts": "^3.5.0",
    "posthog-js": "^1.434.15",
    "ras-stack": "^3.0.0",
    "spacetimedb": "2.10.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "ras-stack-config": "^1.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.15.0"
}
